<package name='phylonco.lphybeast' version='1.3.0'>
    <!-- phylonco beast -->
    <depends on='phylonco' atleast='1.3.0'/>
    <depends on='lphybeast' atleast='1.4.0'/>

    <!--  include lphybeast  -->
    <depends on='lphybeast-flc' atleast='1.3.0'/>

    <!-- add BEAST2 service below  -->
    <service type="beast.base.evolution.datatype.DataType">
        <!-- any ? -->
<!--        <provider classname="phylonco.beast.evolution.datatype.NucleotideDiploid10"/>-->
    </service>
    
    <service type="beast.base.core.BEASTInterface">
<!-- any ? -->
    </service>

    <!-- add lphybeast ext below: LBPhylonco implements lphybeast.spi.LPhyBEASTMapping, which is the
         service type lphybeast core discovers via BEASTClassLoader.loadService(LPhyBEASTMapping.class)
         (the old "LPhyBEASTExt" type was never found, so phylonco's generators didn't load). -->
    <service type="lphybeast.spi.LPhyBEASTMapping">
        <provider classname="phylonco.lphybeast.spi.LBPhylonco"/>
    </service>

</package>
