<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion>
    <!-- phylonco version   -->
    <groupId>io.github.bioDS</groupId>
    <artifactId>beast-phylonco-root</artifactId>
    <version>1.3.0</version>
    <packaging>pom</packaging>

    <name>beast-phylonco</name>
    <url>https://github.com/biods/beast-phylonco</url>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- dependencies       -->
        <lphy.version>1.8.0-beta1</lphy.version>
        <lphybeast.version>1.4.0-beta1</lphybeast.version>
        <beast.version>2.8.0-beta7</beast.version>
        <flc.version>1.3.0-beta1</flc.version>

        <!-- own module versions, referenced by sibling modules instead of ${project.version} -->
        <phylonco-beast.version>1.3.0-SNAPSHOT</phylonco-beast.version>
        <phylonco-lphy.version>1.3.0-SNAPSHOT</phylonco-lphy.version>
        <phylonco-lphybeast.version>1.3.0-SNAPSHOT</phylonco-lphybeast.version>
        <phylonco-lphybeast-launcher.version>1.3.0-SNAPSHOT</phylonco-lphybeast-launcher.version>

        <!-- shared third-party dependency/plugin versions -->
        <junit-jupiter.version>5.10.2</junit-jupiter.version>
        <maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>

        <!-- default args for `mvn -pl phylonco-lphybeast-launcher exec:exec` -->
        <lphybeast.args>-h</lphybeast.args>
    </properties>

    <modules>
        <module>phylonco-beast</module>
        <module>phylonco-lphy</module>
        <module>phylonco-lphybeast</module>
        <module>phylonco-lphy-studio</module>
        <module>phylonco-lphybeast-launcher</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- internal modules -->
            <dependency>
                <groupId>io.github.bioDS</groupId>
                <artifactId>phylonco-beast</artifactId>
                <version>${phylonco-beast.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.bioDS</groupId>
                <artifactId>phylonco-lphy</artifactId>
                <version>${phylonco-lphy.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.bioDS</groupId>
                <artifactId>phylonco-lphybeast</artifactId>
                <version>${phylonco-lphybeast.version}</version>
            </dependency>

            <!-- test -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit-jupiter.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>${maven-assembly-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Pin a compiler plugin whose bundled ASM can read JDK 25 (class major 69) bytecode;
                 the inherited default (3.13.0) fails with "Unsupported class file major version 69"
                 against the beast 2.8 dependencies. phylonco-beast already pins the same version. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>