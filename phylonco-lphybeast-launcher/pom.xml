<project>
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.bioDS</groupId>
        <artifactId>beast-phylonco-root</artifactId>
        <version>1.3.0</version>
    </parent>
    <artifactId>phylonco-lphybeast-launcher</artifactId>
    <version>${phylonco-lphybeast-launcher.version}</version>
    <packaging>pom</packaging>
    <name>phylonco-lphybeast-launcher</name>

    <!-- Development composition module — produces no artifact.
         It assembles LPhyBEAST plus the phylonco extension JARs on the JPMS
         module path so `mvn -pl phylonco-lphybeast-launcher exec:exec` runs
         LPhyBEAST with the phylonco extension loaded via ServiceLoader.
         Each dependency is declared directly so that exec-maven-plugin's
         %classpath contains those JARs as first-class entries, independent of
         any transitive-resolution chain through the reactor. -->
    <dependencies>
        <dependency>
            <groupId>io.github.linguaphylo</groupId>
            <artifactId>lphybeast</artifactId>
            <version>${lphybeast.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bioDS</groupId>
            <artifactId>phylonco-lphybeast</artifactId>
            <version>${phylonco-lphybeast.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bioDS</groupId>
            <artifactId>phylonco-lphy</artifactId>
            <version>${phylonco-lphy.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bioDS</groupId>
            <artifactId>phylonco-beast</artifactId>
            <version>${phylonco-beast.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.4ment</groupId>
            <artifactId>flc</artifactId>
            <version>${flc.version}</version>
        </dependency>
    </dependencies>

    <build><plugins>
        <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <configuration>
                <executable>java</executable>
                <classpathScope>compile</classpathScope>
                <!-- ALL-MODULE-PATH: every named JPMS module on the path joins
                     the module graph automatically — ServiceLoader finds all providers -->
                <commandlineArgs>-Dpicocli.disable.closures=true --module-path %classpath --add-modules ALL-MODULE-PATH -m lphy.beast/lphybeast.LPhyBeastMain ${lphybeast.args}</commandlineArgs>
            </configuration>
        </plugin>
    </plugins></build>

</project>
